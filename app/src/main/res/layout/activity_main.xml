<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <TextView
        android:id="@+id/titleTextView"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:background="@color/blue_primary"
        android:gravity="center"
        android:text="@string/music_title"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/nowPlayingTextView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue_light"
        android:ellipsize="end"
        android:paddingLeft="18dp"
        android:paddingTop="12dp"
        android:paddingRight="18dp"
        android:paddingBottom="12dp"
        android:singleLine="true"
        android:text="@string/now_playing_idle"
        android:textColor="@color/blue_primary_dark"
        android:textSize="16sp" />

    <ListView
        android:id="@+id/musicListView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:cacheColorHint="@android:color/transparent"
        android:divider="@color/divider"
        android:dividerHeight="1dp" />

    <LinearLayout
        android:id="@+id/playerBar"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:background="@color/blue_light"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/previousButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginRight="24dp"
            android:background="@drawable/control_button_background"
            android:contentDescription="@string/previous_song"
            android:padding="14dp"
            android:scaleType="center"
            android:src="@drawable/ic_skip_previous" />

        <ImageButton
            android:id="@+id/playButton"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/control_button_background"
            android:contentDescription="@string/play_or_pause"
            android:padding="16dp"
            android:scaleType="center"
            android:src="@drawable/ic_play_arrow" />

        <ImageButton
            android:id="@+id/nextButton"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginLeft="24dp"
            android:background="@drawable/control_button_background"
            android:contentDescription="@string/next_song"
            android:padding="14dp"
            android:scaleType="center"
            android:src="@drawable/ic_skip_next" />
    </LinearLayout>
</LinearLayout>
